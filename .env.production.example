# =============================================================================
# .env.production — PoE HUB Release 1.0
# Copie para .env e preencha os valores marcados com <DEFINIR>
# =============================================================================

# Database (Docker Compose interno)
DATABASE_URL=postgresql://poth:poth@db:5432/poth

# NextAuth (gerar novo com: openssl rand -base64 32)
NEXTAUTH_SECRET=<DEFINIR>
NEXTAUTH_URL=http://localhost:3000

# Encryption key para campos sensiveis (gerar novo com: openssl rand -hex 32)
ENCRYPTION_KEY=<DEFINIR>

# Coletor de preco da concorrencia (G2G): API publica, sem credencial.
# CRON_SECRET autentica a Scheduled Task do Coolify em POST /api/prices/g2g.
# Gere com: openssl rand -hex 32
CRON_SECRET=<DEFINIR>

# Admin seed (trocar a senha padrao!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<DEFINIR — NAO usar admin123>

# Proxy global
PROXY_USERNAME=<DEFINIR>
PROXY_PASSWORD=<DEFINIR>

# Node
NODE_ENV=production

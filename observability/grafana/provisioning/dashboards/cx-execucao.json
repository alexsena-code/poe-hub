{
  "uid": "cx-execucao",
  "title": "CX Execução",
  "description": "Currency Exchange — visão de execução: bridge, jobs, fila, executores, WS e saúde do plan",
  "tags": ["cx", "execucao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Comandos do bridge por cmd/status (rate 5m)",
      "description": "cx_bridge_commands_total{cmd,status} — comandos dirigidos ao ExileApi via arquivo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cmd, status) (rate(cx_bridge_commands_total[5m]))",
          "legendFormat": "{{cmd}} · {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Taxa de erro do bridge (15m)",
      "description": "% de cx_bridge_commands_total com status=error",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(cx_bridge_commands_total{status=\"error\"}[15m])) / clamp_min(sum(rate(cx_bridge_commands_total[15m])), 1e-12)",
          "legendFormat": "erro %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Executores online",
      "description": "cx_executors_online — presença no /ws/executor",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "cx_executors_online", "legendFormat": "online" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Idade do plan.json",
      "description": "max(cx_plan_age_seconds) — plan velho = worker/planner parado",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 14400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "max(cx_plan_age_seconds)", "legendFormat": "idade" }]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Inventário % por executor",
      "description": "cx_inventory_pct — ocupação do inventário reportada pelo executor",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (executor_id) (cx_inventory_pct)",
          "legendFormat": "{{executor_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência de jobs — p50 / p95 (5m)",
      "description": "histogram_quantile sobre cx_job_latency_seconds (createdAt → done/failed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cx_job_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cx_job_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Latência de jobs — heatmap",
      "description": "Distribuição dos buckets de cx_job_latency_seconds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 48 }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(cx_job_latency_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Fila cx_job por status",
      "description": "cx_job_queue_depth{status} — poll de 15s no Postgres",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "cx_job_queue_depth",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mensagens WS por tipo (rate 5m)",
      "description": "cx_ws_messages_total{type} — canal /ws/executor",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "cx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(cx_ws_messages_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    }
  ]
}

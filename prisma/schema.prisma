generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum BotStatus {
  active
  inactive
  banned
  maintenance
}

enum Currency {
  divine
  chaos
  usd
  brl
  other
}

enum SaleUnit {
  divine
  mirror
  exalted
  other
}

enum SimulationStatus {
  draft
  active
  archived
}

enum SimulationKind {
  operational
  forecast
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskModule {
  bots
  prices
  sales
  simulations
  infra
  other
}

enum PoeVersion {
  poe1
  poe2
}

enum UserRole {
  admin
  operator
}

enum BotAlertType {
  error
  loop
  stuck
  inactivity
  hideout
  keyword
}

enum BotAlertSeverity {
  low
  medium
  high
  critical
}

// Câmbio de moedas (Currency Exchange) — modos e ciclo de vida de um flip
enum FillMode {
  manual
  semi
  full
}

enum FillSource {
  ui
  plugin
  auto
}

enum FillStatus {
  open // ordem de compra postada, ainda enchendo
  holding // comprou, segurando inventário (venda ainda não fechou)
  closed // round-trip completo (comprou e vendeu)
  cancelled
}

// ============================================================
// Models
// ============================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(operator)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedTasks Task[]             @relation("AssignedTasks")
  createdTasks  Task[]             @relation("CreatedTasks")
  conversations ChatConversation[]

  @@map("users")
}

model Bot {
  id        String    @id @default(uuid())
  nick      String
  email     String
  password  String // encrypted
  proxyIp   String    @map("proxy_ip")
  proxyEol  DateTime? @map("proxy_eol")
  status    BotStatus @default(active)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  instances BotInstance[]

  @@index([status])
  @@map("bots")
}

model ProxyConfig {
  id        String   @id @default(uuid())
  port      Int      @default(8080)
  username  String // encrypted
  password  String // encrypted
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("proxy_config")
}

model PriceEntry {
  id               String   @id @default(uuid())
  discordMessageId String   @unique @map("discord_message_id")
  discordChannelId String   @map("discord_channel_id")
  discordServerId  String   @map("discord_server_id")
  authorDiscordId  String   @map("author_discord_id")
  authorName       String   @map("author_name")
  isCnl            Boolean  @default(false) @map("is_cnl")
  price            Decimal  @db.Decimal(18, 8)
  currency         Currency
  item             String?
  rawMessage       String   @map("raw_message")
  messageTimestamp DateTime @map("message_timestamp")
  league           String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([discordChannelId])
  @@index([messageTimestamp])
  @@index([currency])
  @@index([isCnl])
  @@index([league])
  @@map("price_entries")
}

model DailyPrice {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  item        String // divine, mirror, chaos
  league      String   @default("")
  currency    String   @default("brl") // brl, usd
  median      Decimal  @db.Decimal(18, 8)
  mean        Decimal  @db.Decimal(18, 8)
  min         Decimal  @db.Decimal(18, 8)
  max         Decimal  @db.Decimal(18, 8)
  cnlPrice    Decimal? @map("cnl_price") @db.Decimal(18, 8)
  sellCount   Int      @map("sell_count")
  buyCount    Int      @map("buy_count")
  totalOffers Int      @map("total_offers")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, item, league, currency])
  @@index([date])
  @@index([item])
  @@index([league])
  @@map("daily_prices")
}

model DiscordSource {
  id           String   @id @default(uuid())
  serverId     String   @map("server_id")
  serverName   String   @map("server_name")
  channelId    String   @map("channel_id")
  channelName  String   @map("channel_name")
  isActive     Boolean  @default(true) @map("is_active")
  cnlAuthorIds String[] @map("cnl_author_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([serverId, channelId])
  @@map("discord_sources")
}

model Sale {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  buyerId        String   @map("buyer_id")
  quantity       Decimal  @db.Decimal(18, 8)
  unit           SaleUnit
  divinePriceUsd Decimal? @map("divine_price_usd") @db.Decimal(18, 8)
  divinePriceBrl Decimal? @map("divine_price_brl") @db.Decimal(18, 8)
  totalUsd       Decimal? @map("total_usd") @db.Decimal(18, 2)
  totalBrl       Decimal? @map("total_brl") @db.Decimal(18, 2)
  league         String
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  buyer Buyer @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([date])
  @@index([league])
  @@map("sales")
}

model Buyer {
  id        String   @id @default(uuid())
  name      String
  isCnl     Boolean  @default(false) @map("is_cnl")
  contact   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@map("buyers")
}

// ============================================================
// Currency Exchange — Log de fills (flips chaos<->item<->divine in-game)
// Distinto de `sales` (vendas RMT em USD/BRL). Aqui é câmbio in-game, e os
// campos extras (qAhead, fairAtEntry, posted vs filled) calibram o fill-prob.
// ============================================================

model Fill {
  id     String     @id @default(uuid())
  league String
  item   String // ex.: "Orb of Annulment"
  base   String     @default("Chaos Orb") // moeda base do flip
  mode   FillMode   @default(manual)
  source FillSource @default(ui)
  status FillStatus @default(open)

  // perna COMPRA
  buyRatio    Decimal?  @map("buy_ratio") @db.Decimal(18, 6) // preço/un pago (base/item)
  buyQty      Decimal?  @map("buy_qty") @db.Decimal(18, 4)
  buyPostedAt DateTime? @map("buy_posted_at") // ENTRADA (default now no clique)
  buyFilledAt DateTime? @map("buy_filled_at")
  buyQAhead   Decimal?  @map("buy_q_ahead") @db.Decimal(18, 2) // fila à frente no post (calibração)

  // perna VENDA
  sellRatio    Decimal?  @map("sell_ratio") @db.Decimal(18, 6)
  sellQty      Decimal?  @map("sell_qty") @db.Decimal(18, 4)
  sellPostedAt DateTime? @map("sell_posted_at")
  sellFilledAt DateTime? @map("sell_filled_at") // SAÍDA (auto via plugin/Faustus)
  sellQAhead   Decimal?  @map("sell_q_ahead") @db.Decimal(18, 2)

  fairAtEntry Decimal? @map("fair_at_entry") @db.Decimal(18, 6) // fair(VAMP) no post (markout)
  pnlChaos    Decimal? @map("pnl_chaos") @db.Decimal(18, 4)
  pnlDiv      Decimal? @map("pnl_div") @db.Decimal(18, 6)

  botInstanceId String?  @map("bot_instance_id") // qual executor (null = manual)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  botInstance BotInstance? @relation(fields: [botInstanceId], references: [id], onDelete: SetNull)

  @@index([league])
  @@index([item])
  @@index([status])
  @@index([buyPostedAt])
  @@index([botInstanceId])
  @@map("cx_fills")
}

model Simulation {
  id             String           @id @default(uuid())
  name           String
  league         String
  status         SimulationStatus @default(draft)
  kind           SimulationKind   @default(operational)
  durationWeeks  Int              @map("duration_weeks")
  startDayOffset Int              @default(0) @map("start_day_offset")
  notes          String?

  // Cost snapshot (copied from GlobalCostConfig when selected)
  costConfigName         String?  @map("cost_config_name")
  proxyCostPerBotMonthly Decimal? @map("sim_proxy_cost_per_bot_monthly") @db.Decimal(10, 2)
  levelingCostPerBot     Decimal? @map("sim_leveling_cost_per_bot") @db.Decimal(10, 2)
  stashPackCostPerBot    Decimal? @map("sim_stash_pack_cost_per_bot") @db.Decimal(10, 2)
  expluginsKeyCostDaily  Decimal? @map("sim_explugins_key_cost_daily") @db.Decimal(10, 4)
  dpbKeyCostDaily        Decimal? @map("sim_dpb_key_cost_daily") @db.Decimal(10, 4)
  customCosts            Json?    @map("sim_custom_costs")

  // Explugins discount: from this 1-based global day onwards, the daily
  // explugins cost is multiplied by (1 - percent/100). null = no discount.
  // Models the dev-side discount that kicks in mid-league when divine drops.
  expluginsDiscountStartDay Int?     @map("explugins_discount_start_day")
  expluginsDiscountPercent  Decimal? @default(50) @map("explugins_discount_percent") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  weeks       SimulationWeek[]
  costLinks   SimulationCostLink[]
  annualLinks AnnualPlanSimulation[]

  @@index([status])
  @@index([league])
  @@index([kind])
  @@map("simulations")
}

model AnnualPlan {
  id                String   @id @default(uuid())
  name              String
  year              Int
  annualCustomCosts Json?    @map("annual_custom_costs")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  simulationLinks AnnualPlanSimulation[]

  @@index([year])
  @@map("annual_plans")
}

model AnnualPlanSimulation {
  annualPlanId String @map("annual_plan_id")
  simulationId String @map("simulation_id")
  position     Int    @default(0)
  // How many times this league runs in the year. Multiplies revenue and
  // costs (each repetition is a fresh league: characters/atlas reset).
  repeatCount  Int    @default(1) @map("repeat_count")

  annualPlan AnnualPlan @relation(fields: [annualPlanId], references: [id], onDelete: Cascade)
  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@id([annualPlanId, simulationId])
  @@index([simulationId])
  @@map("annual_plan_simulations")
}

model SimulationWeek {
  id                    String   @id @default(uuid())
  simulationId          String   @map("simulation_id")
  weekNumber            Int      @map("week_number")
  label                 String?
  defaultActiveBots     Int      @map("default_active_bots")
  defaultDivinePerHour  Decimal  @map("default_divine_per_hour") @db.Decimal(18, 8)
  defaultHoursPerDay    Decimal  @default(24) @map("default_hours_per_day") @db.Decimal(5, 2)
  defaultDivinePriceUsd Decimal? @map("default_divine_price_usd") @db.Decimal(18, 8)
  defaultDivinePriceBrl Decimal? @map("default_divine_price_brl") @db.Decimal(18, 8)
  buildCostDivines      Decimal? @map("build_cost_divines") @db.Decimal(18, 4)

  simulation Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  days       SimulationDay[]

  @@unique([simulationId, weekNumber])
  @@map("simulation_weeks")
}

model SimulationDay {
  id               String    @id @default(uuid())
  simulationWeekId String    @map("simulation_week_id")
  dayNumber        Int       @map("day_number")
  date             DateTime? @db.Date
  activeBots       Int?      @map("active_bots")
  divinePerHour    Decimal?  @map("divine_per_hour") @db.Decimal(18, 8)
  hoursPerDay      Decimal?  @map("hours_per_day") @db.Decimal(5, 2)
  divinePriceUsd   Decimal?  @map("divine_price_usd") @db.Decimal(18, 8)
  divinePriceBrl   Decimal?  @map("divine_price_brl") @db.Decimal(18, 8)
  overrideNotes    String?   @map("override_notes")

  week SimulationWeek @relation(fields: [simulationWeekId], references: [id], onDelete: Cascade)

  @@unique([simulationWeekId, dayNumber])
  @@map("simulation_days")
}

model GlobalCostConfig {
  id                     String   @id @default(uuid())
  name                   String
  isDefault              Boolean  @default(false) @map("is_default")
  proxyCostPerBotMonthly Decimal  @map("proxy_cost_per_bot_monthly") @db.Decimal(10, 2)
  levelingCostPerBot     Decimal  @map("leveling_cost_per_bot") @db.Decimal(10, 2)
  stashPackCostPerBot    Decimal  @default(0) @map("stash_pack_cost_per_bot") @db.Decimal(10, 2)
  expluginsKeyCostDaily  Decimal  @map("explugins_key_cost_daily") @db.Decimal(10, 4)
  dpbKeyCostDaily        Decimal  @map("dpb_key_cost_daily") @db.Decimal(10, 4)
  customCosts            Json?    @map("custom_costs")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  simulationLinks SimulationCostLink[]

  @@map("global_cost_configs")
}

model SimulationCostLink {
  simulationId String @map("simulation_id")
  costConfigId String @map("cost_config_id")

  simulation Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  costConfig GlobalCostConfig @relation(fields: [costConfigId], references: [id], onDelete: Cascade)

  @@id([simulationId, costConfigId])
  @@map("simulation_cost_links")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(backlog)
  priority    TaskPriority @default(medium)
  assignedTo  String?      @map("assigned_to")
  createdBy   String       @map("created_by")
  dueDate     DateTime?    @map("due_date") @db.Date
  league      String?
  module      TaskModule?
  position    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  assignee User? @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator  User  @relation("CreatedTasks", fields: [createdBy], references: [id])

  @@index([status])
  @@index([assignedTo])
  @@index([priority])
  @@index([module])
  @@map("tasks")
}

model League {
  id         String     @id @default(uuid())
  name       String     @unique
  poeVersion PoeVersion @map("poe_version")
  startDate  DateTime?  @map("start_date") @db.Date
  endDate    DateTime?  @map("end_date") @db.Date
  isCurrent  Boolean    @default(false) @map("is_current")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("leagues")
}

model BotInstance {
  id            String    @id @default(uuid())
  botId         String?   @map("bot_id")
  pcName        String    @map("pc_name")
  configName    String    @map("config_name")
  characterName String?   @map("character_name")
  league        String?
  currentArea   String?   @map("current_area")
  botVersion    String?   @map("bot_version")
  isOnline      Boolean   @default(false) @map("is_online")
  lastSeen      DateTime? @map("last_seen")
  connectedAt   DateTime? @map("connected_at")
  totalLogs     Int       @default(0) @map("total_logs")
  errorCount    Int       @default(0) @map("error_count")
  warnCount     Int       @default(0) @map("warn_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bot    Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  alerts BotAlert[]
  fills  Fill[]

  @@unique([pcName, configName])
  @@index([botId])
  @@index([isOnline])
  @@index([pcName])
  @@map("bot_instances")
}

model BotAlert {
  id             String           @id @default(uuid())
  instanceId     String           @map("instance_id")
  type           BotAlertType     @map("type")
  severity       BotAlertSeverity @map("severity")
  title          String
  message        String
  details        String?
  acknowledged   Boolean          @default(false)
  acknowledgedAt DateTime?        @map("acknowledged_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  instance BotInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([type])
  @@index([createdAt])
  @@map("bot_alerts")
}

// ============================================================
// Q&A Chat
// ============================================================

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]
  user     User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  role             String
  content          String
  layers           Json?
  tokenEstimate    Int?     @map("token_estimate")
  latencyMs        Int?     @map("latency_ms")
  detectedPageType String?  @map("detected_page_type")
  cost             Json?
  createdAt        DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

// ============================================================
// Currency Exchange — dados de mercado + sinais (alimentados pelo worker cxw).
// Float (não Decimal) porque são analytics/triagem, não contabilidade.
// Cada linha tem capturedAt (versionado por rodada). Espelha os tipos de
// lib/cx-mock.ts — o provider troca o mock por queries nestas tabelas.
// ============================================================

model CxSignal {
  id          String   @id @default(uuid())
  league      String
  item        String
  base        String   @default("Chaos Orb")
  // book
  bid         Float?
  ask         Float?
  spreadPct   Float?   @map("spread_pct")
  mmBuy       Float?   @map("mm_buy")
  mmSell      Float?   @map("mm_sell")
  mmSpreadPct Float?   @map("mm_spread_pct")
  capDiv      Float?   @map("cap_div")
  // Tier 1
  fairVamp    Float?   @map("fair_vamp")
  obi         Float?
  slipPct     Float?   @map("slip_pct")
  halfLifeH   Float?   @map("half_life_h")
  driftDay    Float?   @map("drift_day")
  volPct      Float?   @map("vol_pct")
  kelly       Float?
  markoutPct  Float?   @map("markout_pct")
  liqPerH     Float?   @map("liq_per_h")
  // fill-prob
  pFillBuy    Float?   @map("p_fill_buy")
  pFillSell   Float?   @map("p_fill_sell")
  pRoundtrip  Float?   @map("p_roundtrip")
  eTFillH     Float?   @map("e_t_fill_h")
  qAheadBuy   Float?   @map("q_ahead_buy")
  qAheadSell  Float?   @map("q_ahead_sell")
  // validação cxapi + confiança
  cxapiLo     Float?   @map("cxapi_lo")
  cxapiHi     Float?   @map("cxapi_hi")
  cxapiOk     Boolean? @map("cxapi_ok")
  conf        String   // ok | fina | baixa
  capturedAt  DateTime @map("captured_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([league, capturedAt])
  @@index([item])
  @@map("cx_signal")
}

model CxArb {
  id             String   @id @default(uuid())
  league         String
  item           String
  priceChaos     Float    @map("price_chaos")
  priceViaDivine Float    @map("price_via_divine")
  discPct        Float    @map("disc_pct")
  grainPct       Float    @map("grain_pct")
  edgePct        Float    @map("edge_pct")
  volDivine      Float    @map("vol_divine")
  conf           String   // ALTA | media | baixa
  capturedAt     DateTime @map("captured_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([league, capturedAt])
  @@map("cx_arb")
}

// Série horária p/ gráficos de preço/volume (do digest da cxapi)
model CxMarketHourly {
  id     String   @id @default(uuid())
  league String
  item   String
  ts     DateTime // hora
  price  Float // chaos/item (mid)
  volume Float

  @@unique([league, item, ts])
  @@index([league, item, ts])
  @@map("cx_market_hourly")
}

// Escada do book capturado in-game (último snapshot por item)
model CxBookLevel {
  id         String   @id @default(uuid())
  league     String
  item       String
  side       String // ask | bid
  price      Float
  qty        Float
  capturedAt DateTime @map("captured_at")

  @@index([league, item, capturedAt])
  @@map("cx_book_level")
}

// ============================================================
// CX Management — gerenciamento do bot de currency exchange
// (executores, fila de comandos, parâmetros, logs, decisões, schedules)
// ============================================================

// Presença persistida do cx-executor (Python local que conecta em /ws/executor).
model CxExecutor {
  id           String    @id @default(uuid())
  executorId   String    @unique @map("executor_id") // ex.: "DESKTOP-ABC-cx"
  pcName       String?   @map("pc_name")
  league       String?
  capabilities Json? // ex.: ["report","command"]
  isOnline     Boolean   @default(false) @map("is_online")
  lastSeen     DateTime? @map("last_seen")
  connectedAt  DateTime? @map("connected_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([isOnline])
  @@map("cx_executor")
}

// Fila de comandos VPS -> executor. O drain do ws-server pega pending do
// executor online e envia {type:"command", id, cmd:type, args:payload}.
model CxJob {
  id          String    @id @default(cuid())
  executorId  String    @map("executor_id")
  type        String // run_job|place_order|cancel|collect|pause|resume|param_update|read_state
  payload     Json
  status      String    @default("pending") // pending|sent|acked|done|failed|expired
  priority    Int       @default(0) // maior = primeiro
  requestedBy String?   @map("requested_by") // userId da sessão que criou
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")
  ackedAt     DateTime? @map("acked_at")
  doneAt      DateTime? @map("done_at")

  @@index([status, executorId])
  @@index([createdAt])
  @@map("cx_job")
}

// Parâmetros de operação (chave-valor com escopo).
model CxParams {
  id        String   @id @default(uuid())
  scope     String // global|executor|item
  scopeKey  String   @default("*") @map("scope_key") // executorId/item ou "*"
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeKey, key])
  @@map("cx_params")
}

// Logs enviados pelos executores (batch via mensagem "logs").
model CxLog {
  id         String   @id @default(uuid())
  executorId String   @map("executor_id")
  level      String // debug|info|warn|error
  message    String
  meta       Json?
  ts         DateTime @default(now())

  @@index([executorId, ts])
  @@map("cx_log")
}

// Trilha de decisões (regra/LLM/manual) — por que cada ação foi tomada.
model CxDecisionLog {
  id         String   @id @default(uuid())
  executorId String?  @map("executor_id")
  source     String // rule|llm|manual
  item       String?
  league     String?
  action     String
  reason     String
  snapshot   Json?
  jobId      String?  @map("job_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([executorId])
  @@map("cx_decision_log")
}

// Agendamentos de jobs (só CRUD nesta fase — execução fica pra próxima).
model CxSchedule {
  id         String    @id @default(uuid())
  name       String
  cron       String
  jobType    String    @map("job_type")
  payload    Json
  executorId String?   @map("executor_id") // null = qualquer/definido na execução
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime? @map("next_run_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([enabled])
  @@map("cx_schedule")
}

# Database
# Dev local: user `poth` (owner) é OK.
# Produção (Vercel → VPS): use o user `poth_app` (CRUD only) com senha forte.
# Ver docs/security/db-hardening.md.
DATABASE_URL=postgresql://poth:poth@localhost:5432/poth

# NextAuth
NEXTAUTH_SECRET=<gerar com: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Encryption key para campos sensíveis (AES-256)
ENCRYPTION_KEY=<gerar com: openssl rand -hex 32>

# OpenRouter (LLM parser do scraper de preços — chave única para todos os modelos)
OPENROUTER_API_KEY=<chave OpenRouter — https://openrouter.ai/keys>
# Opcional: sobrescreve o modelo (default: google/gemini-2.5-flash-lite)
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Discord (para o scraper)
DISCORD_TOKEN=<token do discord>

# Admin seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<definir>

# Proxy global (usado pelo seed)
PROXY_USERNAME=<username do proxy>
PROXY_PASSWORD=<senha do proxy>

# Sanity (write credentials for blog publishing — session 08)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-05-21
SANITY_API_WRITE_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
